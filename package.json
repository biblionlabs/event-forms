{
  "name": "event-forms",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "generate": "nuxt generate",
    "postinstall": "nuxt prepare",
    "db:migrate": "wrangler d1 execute event-forms-db --local --file=database/schema.sql",
    "db:migrate:prod": "wrangler d1 execute event-forms-db --file=database/schema.sql",
    "deploy": "npm run build && wrangler pages deploy dist/"
  },
  "dependencies": {
    "nuxt": "^3.15.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "wrangler": "^3.101.0",
    "typescript": "^5.7.0",
    "@types/qrcode": "^1.5.5"
  }
}
